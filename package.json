{
  "name": "photo-edit-portability-map-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.js",
    "test": "cargo test && node --test site/tests/*.test.mjs && npm run build:site && playwright test",
    "build:site": "vite build --config site/vite.config.js",
    "build:cli": "cargo build --release",
    "build": "npm run build:cli && npm run build:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "vite": "7.3.6"
  }
}
